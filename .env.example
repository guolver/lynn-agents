# --- SQLite (default, no extra setup required) ---
DATABASE_PATH=./data/agent.db

# --- PostgreSQL (uncomment to use) ---
# DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@127.0.0.1:5432/agent_hub

# --- PostgreSQL test database (used by integration tests) ---
# TEST_DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@127.0.0.1:5432/agent_hub_test

# --- Celery / Redis ---
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- Application ---
PUBLIC_BASE_URL=http://localhost:8000
